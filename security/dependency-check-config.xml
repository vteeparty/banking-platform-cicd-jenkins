<?xml version="1.0" encoding="UTF-8"?>
<!--
  Banking Platform — OWASP Dependency Check Configuration
  File   : security/dependency-check-config.xml
  Plugin : org.owasp:dependency-check-maven (or dependency-check-gradle)
  Docs   : https://jeremylong.github.io/DependencyCheck/
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      ═══════════════════════════════════════════════════════════════
      HOW TO USE THIS FILE
      ═══════════════════════════════════════════════════════════════
      1. Run the full dependency check first (no suppressions).
      2. Review each finding in the HTML/XML report.
      3. For each accepted false-positive add a <suppress> entry below
         with a mandatory <notes> explaining the business justification
         and the date the decision was reviewed.
      ═══════════════════════════════════════════════════════════════
    -->

    <!--
    EXAMPLE — suppress a known false-positive CVE
    Remove or replace with real suppressions after the first scan.

    <suppress>
        <notes>
            CVE-2023-XXXXX: The vulnerable code path is not reachable in the
            banking platform because we do not use the affected API.
            Reviewed: 2026-05-18  Reviewer: DevOps Team
        </notes>
        <gav regex="true">^com\.example:example-library:.*$</gav>
        <cve>CVE-2023-XXXXX</cve>
    </suppress>
    -->

</suppressions>
