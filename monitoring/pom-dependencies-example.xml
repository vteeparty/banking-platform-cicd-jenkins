# ============================================================
# Example: pom.xml Dependencies for Monitoring
# ============================================================
#
# Add these dependencies to your Spring Boot microservice's pom.xml
# to enable metrics collection and Prometheus exposition.
#
# Location in pom.xml: <dependencies> section
# ============================================================

<!-- Spring Boot Actuator: Exposes operational endpoints (health, metrics, etc.) -->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-actuator</artifactId>
    <!-- Version inherited from spring-boot-starter-parent -->
</dependency>

<!-- Micrometer Prometheus Registry: Formats metrics for Prometheus -->
<!-- Micrometer is the metrics library included in Actuator by default -->
<dependency>
    <groupId>io.micrometer</groupId>
    <artifactId>micrometer-registry-prometheus</artifactId>
    <!-- Version inherited from spring-boot-starter-parent -->
</dependency>

<!-- 
  OPTIONAL: Add custom metrics support (if you want to track business logic)
  
  <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
  </dependency>
  
  Then in your code:
  
  @Component
  public class PaymentMetrics {
    private final MeterRegistry meterRegistry;
    
    public PaymentMetrics(MeterRegistry meterRegistry) {
      this.meterRegistry = meterRegistry;
      Counter.builder("banking.payments.processed")
        .description("Total payments processed")
        .register(meterRegistry);
    }
  }
-->

