# ============================================================
# Environment Configuration for Monitoring Stack
# ============================================================
#
# Copy this file to .env and customize for your environment.
#
# Usage:
#   cp .env.example .env
#   docker-compose --env-file .env up -d
#
# ============================================================

# ── Prometheus Configuration ─────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_SCRAPE_INTERVAL=30s

# ── Grafana Configuration ────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Microservices Configuration ──────────────────────────────
# Adjust these ports if your services run on different ports.

PAYMENT_SERVICE_HOST=payment-service
PAYMENT_SERVICE_PORT=8080

TRANSACTION_SERVICE_HOST=transaction-service
TRANSACTION_SERVICE_PORT=8081

NOTIFICATION_SERVICE_HOST=notification-service
NOTIFICATION_SERVICE_PORT=8082

# ── Memory Configuration ─────────────────────────────────────
# Adjust based on your machine's available resources.

PROMETHEUS_MEMORY_LIMIT=512M
PROMETHEUS_MEMORY_RESERVATION=256M

GRAFANA_MEMORY_LIMIT=512M
GRAFANA_MEMORY_RESERVATION=256M

# ── Network Configuration ────────────────────────────────────
MONITORING_NETWORK=banking-monitoring

# ── Volume Paths (leave empty for default) ──────────────────
# For Docker Desktop on Windows/Mac, use relative paths.
# For Linux with named volumes, leave empty.

PROMETHEUS_DATA_PATH=./prometheus-data
GRAFANA_DATA_PATH=./grafana-storage
