// ============================================================
// Banking Platform — Build-Only Pipeline
// Runs compile + unit tests only (no Docker push, no SonarQube)
// Intended for feature branch validation and PR checks
// ============================================================

pipeline {

    agent any

    environment {
        APP_NAME = 'banking-platform'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Skip unit tests')
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Checking out branch: ${GIT_BRANCH}"
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Compiling application...'
                sh '''
                    echo "Build step: compile only"
                    # mvn clean compile
                    # ./gradlew classes
                '''
            }
        }

        stage('Unit Tests') {
            when {
                not { expression { params.SKIP_TESTS } }
            }
            steps {
                echo 'Running unit tests...'
                sh '''
                    echo "Test step: unit tests"
                    # mvn test
                    # ./gradlew test
                '''
            }
            post {
                always {
                    script {
                        if (fileExists('target/surefire-reports/*.xml') || fileExists('build/test-results/**/*.xml')) {
                            junit allowEmptyResults: true, testResults: '**/surefire-reports/*.xml, **/test-results/**/*.xml'
                        }
                    }
                }
            }
        }

        stage('Package') {
            steps {
                echo 'Packaging artifact...'
                sh '''
                    echo "Package step: creating deployable artifact"
                    # mvn package -DskipTests
                    # ./gradlew assemble
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.jar, **/build/libs/*.jar', allowEmptyArchive: true
                }
            }
        }

        stage('Build Status') {
            steps {
                echo "Build #${BUILD_NUMBER} on branch ${GIT_BRANCH} — PASSED"
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Build-only pipeline SUCCESS — ${APP_NAME} #${BUILD_NUMBER}"
        }
        failure {
            echo "Build-only pipeline FAILED — ${APP_NAME} #${BUILD_NUMBER}. Check logs above."
        }
    }
}
