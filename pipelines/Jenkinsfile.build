// ============================================================
// Banking Platform — Build-Only Pipeline
// Runs compile + unit tests + package (no Docker, no SonarQube)
// Intended for feature branch validation and PR checks
// ============================================================

pipeline {

    agent any

    // ── Environment ──────────────────────────────────────────
    environment {
        APP_NAME   = 'banking-platform'
        MAVEN_OPTS = '-Xmx512m'
    }

    // ── Pipeline Options ──────────────────────────────────────
    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    // ── Parameters ────────────────────────────────────────────
    parameters {
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Skip unit tests')
    }

    // ── Stages ────────────────────────────────────────────────
    stages {

        // ── Stage 1: Clone Repository ────────────────────────
        stage('Clone Repository') {
            steps {
                echo "Cloning repository for branch: ${env.GIT_BRANCH ?: 'default'}"
                checkout scm
                echo 'Repository cloned successfully.'
            }
        }

        // ── Stage 2: Maven Build (compile only) ───────────────
        stage('Maven Build') {
            steps {
                echo 'Compiling all microservices...'
                sh 'mvn clean compile'
                echo 'Compile completed successfully.'
            }
        }

        // ── Stage 3: Run Unit Tests ───────────────────────────
        stage('Run Unit Tests') {
            when {
                not { expression { params.SKIP_TESTS } }
            }
            steps {
                echo 'Running unit tests...'
                sh 'mvn test'
            }
            post {
                always {
                    // Publish JUnit test results from Surefire reports
                    junit allowEmptyResults: true,
                          testResults: '**/target/surefire-reports/*.xml'
                    echo 'Test results published.'
                }
            }
        }

        // ── Stage 4: Package ──────────────────────────────────
        stage('Package') {
            steps {
                echo 'Packaging microservices into JAR files...'
                sh 'mvn package -DskipTests'
                echo 'Packaging completed successfully.'
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.jar',
                                     fingerprint: true,
                                     allowEmptyArchive: false
                    echo 'Artifacts archived.'
                }
            }
        }

    }

    // ── Post Actions ──────────────────────────────────────────
    post {
        success {
            echo "BUILD SUCCESS — ${env.APP_NAME} #${env.BUILD_NUMBER} (${env.GIT_BRANCH ?: 'unknown branch'})"
        }
        failure {
            echo "BUILD FAILED — ${env.APP_NAME} #${env.BUILD_NUMBER}. Check the logs above."
        }
        always {
            echo 'Build pipeline finished.'
        }
    }
}
