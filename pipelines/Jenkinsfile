// ============================================================
// Banking Platform — CI Pipeline
// Jenkins Declarative Pipeline (Beginner-Friendly, Local)
// Stages: Clone → Build → Test → SonarQube Scan → Archive
//         → Docker Build → Trivy Security Scan → ZAP DAST Scan
//
// PRE-REQUISITE — Start SonarQube in Docker (run once on your machine):
//
//   docker run -d \
//     --name sonarqube \
//     -p 9000:9000 \
//     sonarqube:community
//
//   Then open http://localhost:9000 in your browser.
//   Default credentials: admin / admin (you will be prompted to change them).
//
// PRE-REQUISITE — Install Trivy on the Jenkins host machine (run once):
//
//   Option A – using the official install script (Linux/WSL):
//     curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin
//
//   Option B – using apt (Ubuntu/Debian):
//     sudo apt-get install wget apt-transport-https gnupg lsb-release -y
//     wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key | sudo apt-key add -
//     echo deb https://aquasecurity.github.io/trivy-repo/deb $(lsb_release -sc) main | sudo tee -a /etc/apt/sources.list.d/trivy.list
//     sudo apt-get update && sudo apt-get install trivy -y
//
//   Verify installation:
//     trivy --version
//
//   NOTE: Docker must also be installed and running on the Jenkins host so that
//         Trivy can pull and inspect the local image layers.
//
// PRE-REQUISITE — OWASP ZAP DAST Scan (Stage 8 — no install needed):
//   ZAP runs inside a Docker container that is pulled automatically.
//   Your microservice must be running on port 8081 BEFORE Stage 8 executes.
//   Start it using one of:
//
//     Option A — Maven dev server:
//       mvn spring-boot:run -Dspring-boot.run.arguments="--server.port=8081"
//
//     Option B — run the packaged JAR:
//       java -jar target/banking-platform.jar --server.port=8081
//
//     Option C — run the Docker image built in Stage 6:
//       docker run -d -p 8081:8081 banking-platform:<build-number>
//
//   On Linux/WSL, map host.docker.internal if it is not present:
//     echo "$(ip route show default | awk '{print $3}') host.docker.internal" \
//       | sudo tee -a /etc/hosts
//   (Docker Desktop on Windows and Mac handles this automatically.)
//
// JENKINS SETUP (one-time):
//   1. Install "SonarQube Scanner" plugin in Jenkins.
//   2. Go to Manage Jenkins → System → SonarQube Servers.
//      Name: SonarQube-Local   URL: http://localhost:9000
//   3. Go to Manage Jenkins → Tools → SonarQube Scanner installations.
//      Name: SonarScanner   ✔ Install automatically
// ============================================================

pipeline {

    agent any

    // ── Environment ──────────────────────────────────────────
    environment {
        APP_NAME    = 'banking-platform'
        MAVEN_OPTS  = '-Xmx512m'

        // Name must match what you entered in Manage Jenkins → System → SonarQube Servers
        SONAR_SERVER = 'SonarQube-Local'

        // Docker image name tagged with the Jenkins build number so every build
        // produces a unique, traceable image (e.g. banking-platform:42).
        // Change 'banking-platform' to match your actual Docker image name.
        IMAGE_NAME   = "banking-platform:${BUILD_NUMBER}"
    }

    // ── Pipeline Options ──────────────────────────────────────
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        timeout(time: 30, unit: 'MINUTES')   // increased to accommodate ZAP DAST scan (~5–8 min)
        disableConcurrentBuilds()
    }

    // ── Stages ────────────────────────────────────────────────
    stages {

        // ── Stage 1: Clone Repository ────────────────────────
        stage('Clone Repository') {
            steps {
                echo "Cloning repository for branch: ${env.GIT_BRANCH ?: 'default'}"
                checkout scm
                echo 'Repository cloned successfully.'
            }
        }

        // ── Stage 2: Maven Build ─────────────────────────────
        stage('Maven Build') {
            steps {
                echo 'Building all microservices with Maven...'
                sh 'mvn clean package -DskipTests'
                echo 'Maven build completed successfully.'
            }
        }

        // ── Stage 3: Run Unit Tests ───────────────────────────
        stage('Run Unit Tests') {
            steps {
                echo 'Running unit tests...'
                sh 'mvn test'
            }
            post {
                always {
                    // Publish JUnit test results from Surefire reports
                    junit allowEmptyResults: true,
                          testResults: '**/target/surefire-reports/*.xml'
                    echo 'Test results published.'
                }
            }
        }

        // ── Stage 4: SonarQube Code Analysis ─────────────────
        //
        // What this stage does:
        //   • Runs the Maven SonarQube plugin against your source code.
        //   • Sends results to the local SonarQube server (http://localhost:9000).
        //   • Reports bugs, code smells, vulnerabilities, and test coverage.
        //
        // The full Maven command being executed is:
        //   mvn sonar:sonar \
        //     -Dsonar.projectKey=banking-platform \
        //     -Dsonar.host.url=http://localhost:9000 \
        //     -Dsonar.scm.disabled=true
        //
        // Additional scanner properties are read from:
        //   security/sonarqube-config.properties
        //
        // After the pipeline runs, open http://localhost:9000 and look for
        // the "banking-platform" project to see the full analysis report.
        stage('SonarQube Analysis') {
            steps {
                // withSonarQubeEnv automatically injects SONAR_HOST_URL and
                // SONAR_AUTH_TOKEN from the Jenkins server configuration,
                // so you do not have to hard-code the URL in this file.
                withSonarQubeEnv("${SONAR_SERVER}") {
                    echo 'Starting SonarQube code analysis...'
                    sh """
                        mvn sonar:sonar \
                          -Dsonar.projectKey=banking-platform \
                          -Dsonar.projectName='Banking Platform CI/CD' \
                          -Dsonar.projectVersion=1.0 \
                          -Dsonar.sources=src/main \
                          -Dsonar.tests=src/test \
                          -Dsonar.java.binaries=target/classes \
                          -Dsonar.java.test.binaries=target/test-classes \
                          -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
                          -Dsonar.exclusions='**/generated/**,**/target/**,**/*Config.java,**/*Configuration.java,**/db/migration/**' \
                          -Dsonar.scm.disabled=true
                    """
                    echo 'SonarQube analysis completed. Check http://localhost:9000 for results.'
                }
            }
        }

        // ── Stage 5: Archive Artifacts ────────────────────────
        stage('Archive Artifacts') {
            steps {
                echo 'Archiving JAR files...'
                archiveArtifacts artifacts: '**/target/*.jar',
                                 fingerprint: true,
                                 allowEmptyArchive: false
                echo 'Artifacts archived successfully.'
            }
        }

        // ── Stage 6: Docker Build ─────────────────────────────
        //
        // What this stage does:
        //   • Builds a Docker image from the Dockerfile in the project root.
        //   • Tags the image with the Jenkins build number so you can trace
        //     exactly which pipeline run produced each image.
        //
        // PRE-REQUISITE:
        //   • A Dockerfile must exist in the root of your project.
        //   • Docker must be installed and running on the Jenkins host.
        //   • The Jenkins process user must have permission to run Docker
        //     (add the user to the 'docker' group: sudo usermod -aG docker jenkins).
        //
        // After a successful build you can verify the image locally with:
        //   docker images | grep banking-platform
        stage('Docker Build') {
            steps {
                echo "Building Docker image: ${IMAGE_NAME}..."
                // 'docker build' reads the Dockerfile in the workspace root (.).
                // The -t flag assigns the image name and tag defined in IMAGE_NAME.
                sh "docker build -t ${IMAGE_NAME} ."
                echo "Docker image ${IMAGE_NAME} built successfully."
            }
        }

        // ── Stage 7: Trivy Security Scan ──────────────────────
        //
        // What this stage does:
        //   • Scans the Docker image built in the previous stage for known
        //     OS-package and application-dependency vulnerabilities (CVEs).
        //   • Step 1 — prints ALL vulnerabilities (LOW, MEDIUM, HIGH, CRITICAL)
        //     to the Jenkins console as an informational summary.  This step
        //     never fails the pipeline so you can see the full picture.
        //   • Step 2 — re-runs the scan scoped to HIGH and CRITICAL only.
        //     '--exit-code 1' tells Trivy to return a non-zero exit code when
        //     any matching CVEs are found, which causes Jenkins to mark the
        //     build as FAILED.  Fix the HIGH/CRITICAL issues before merging.
        //
        // Reading the output:
        //   • Each row shows: Library | Vulnerability ID | Severity | Installed version | Fixed version
        //   • Rows highlighted in red/bold are HIGH or CRITICAL.
        //   • 'Fixed Version' tells you the minimum safe version to upgrade to.
        //
        // PRE-REQUISITE:
        //   • Trivy must be installed on the Jenkins host machine.
        //     See the install instructions at the top of this file.
        stage('Trivy Security Scan') {
            steps {
                echo "Starting Trivy security scan on image: ${IMAGE_NAME}..."

                // ── Step 1: Print all severities (informational) ──────────
                // '--exit-code 0'  → never fail on this step; always print results
                // '--severity'     → comma-separated list of severity levels to report
                // '--no-progress'  → suppress the progress bar for cleaner Jenkins logs
                // '--format table' → human-readable table output in the console
                echo '--- Trivy full report (LOW, MEDIUM, HIGH, CRITICAL) ---'
                sh """
                    trivy image \\
                        --exit-code 0 \\
                        --severity LOW,MEDIUM,HIGH,CRITICAL \\
                        --no-progress \\
                        --format table \\
                        ${IMAGE_NAME}
                """

                // ── Step 2: Fail pipeline on HIGH or CRITICAL only ────────
                // '--exit-code 1'  → return exit code 1 (build failure) when
                //                    vulnerabilities at the listed severities are found
                // '--severity HIGH,CRITICAL' → only flag serious vulnerabilities
                // This keeps the pipeline green for informational LOW/MEDIUM issues
                // while enforcing a hard stop on serious security risks.
                echo '--- Trivy strict check (HIGH and CRITICAL only) ---'
                sh """
                    trivy image \\
                        --exit-code 1 \\
                        --severity HIGH,CRITICAL \\
                        --no-progress \\
                        --format table \\
                        ${IMAGE_NAME}
                """

                echo 'Trivy security scan completed. No HIGH or CRITICAL vulnerabilities found.'
            }
            post {
                // This runs whether the stage passed or failed, giving you a
                // clear message in the Jenkins console in both cases.
                failure {
                    echo """TRIVY SCAN FAILED — HIGH or CRITICAL vulnerabilities were detected in ${IMAGE_NAME}.
Review the table above, upgrade the affected libraries to the 'Fixed Version' shown,
rebuild the image, and re-run the pipeline."""
                }
                success {
                    echo "Trivy scan passed — ${IMAGE_NAME} has no HIGH or CRITICAL vulnerabilities."
                }
            }
        }

        // ── Stage 8: OWASP ZAP DAST Scan ─────────────────────────────
        //
        // What this stage does:
        //   • Performs Dynamic Application Security Testing (DAST) by sending
        //     real HTTP requests to your *running* Spring Boot microservice —
        //     the same way an attacker would probe it from the outside.
        //   • Uses the official OWASP ZAP Docker image; no local ZAP install
        //     needed on the Jenkins host.
        //   • Runs zap-baseline.py — a passive-only scan that:
        //       - Spiders the target URL to discover endpoints.
        //       - Checks for common issues: missing security headers,
        //         insecure cookie flags, information disclosure, etc.
        //       - Does NOT send destructive or active attack payloads, so it
        //         is safe to run against a development API.
        //   • Saves a full annotated HTML report as a Jenkins build artifact.
        //   • Marks the build UNSTABLE (not outright FAILED) when FAIL-level
        //     alerts are found, so the team can review the report before
        //     deciding whether to block the release.
        //
        // How to read the console output:
        //   PASS  → check passed, no issue found
        //   WARN  → informational finding (build stays GREEN)
        //   FAIL  → serious finding    (build marked UNSTABLE)
        //
        // Customising alert thresholds (advanced):
        //   Edit security/zap-rules.tsv to IGNORE, WARN, or FAIL on specific
        //   alert IDs, then add '-c /zap/wrk/zap-rules.tsv' to the docker run
        //   command below and mount the file into /zap/wrk/.
        //   Reference: https://www.zaproxy.org/docs/docker/baseline-scan/
        stage('OWASP ZAP DAST Scan') {
            steps {
                echo '============================================================'
                echo 'OWASP ZAP — Dynamic Application Security Testing (DAST)'
                echo 'Target : http://host.docker.internal:8081'
                echo 'Mode   : Baseline scan (passive checks only — no active attack payloads)'
                echo '============================================================'

                // Create a workspace-local output directory.
                // This folder is bind-mounted into the ZAP container so the
                // HTML report lands directly in the Jenkins workspace.
                sh 'mkdir -p zap-reports'

                script {
                    // ── Run OWASP ZAP Baseline Scan ──────────────────────────
                    //
                    // docker run --rm
                    //   Spin up the container, run the scan, auto-remove on exit.
                    //   No leftover containers clutter the Jenkins host.
                    //
                    // --add-host=host.docker.internal:host-gateway
                    //   Resolves 'host.docker.internal' to the Docker host inside
                    //   the container.  Required on Linux; Docker Desktop on
                    //   Windows/Mac injects this entry automatically.
                    //
                    // -v "$(pwd)/zap-reports:/zap/wrk:rw"
                    //   Bind-mount the local zap-reports/ directory to /zap/wrk
                    //   inside the container.  ZAP writes the HTML report to
                    //   /zap/wrk/zap-report.html, which appears in the workspace.
                    //
                    // ghcr.io/zaproxy/zaproxy:stable
                    //   Official OWASP ZAP image from GitHub Container Registry.
                    //   'stable' always resolves to the latest stable release.
                    //
                    // zap-baseline.py
                    //   Built-in ZAP script.  Passive scan only — safe for any API.
                    //
                    // -t http://host.docker.internal:8081
                    //   Target URL: the microservice running on the host machine.
                    //   Change 8081 to the port your service listens on.
                    //
                    // -r zap-report.html
                    //   HTML output file written to /zap/wrk/ (→ zap-reports/).
                    //
                    // -l WARN
                    //   Log level: include PASS, WARN, and FAIL in console output
                    //   so you see the full picture at a glance.
                    //
                    // -I
                    //   Ignore-warn flag: exit with code 0 even if WARN-level
                    //   alerts are raised.  Only FAIL-level alerts produce
                    //   a non-zero exit code (code 2), which we handle below.
                    def zapExitCode = sh(
                        script: """
                            docker run --rm \\
                                --add-host=host.docker.internal:host-gateway \\
                                -v "\$(pwd)/zap-reports:/zap/wrk:rw" \\
                                ghcr.io/zaproxy/zaproxy:stable \\
                                zap-baseline.py \\
                                    -t http://host.docker.internal:8081 \\
                                    -r zap-report.html \\
                                    -l WARN \\
                                    -I
                        """,
                        returnStatus: true
                    )

                    echo '============================================================'
                    echo "ZAP scan complete. Exit code: ${zapExitCode}"
                    echo '  0 → No FAIL-level alerts  (build stays GREEN)'
                    echo '  1 → WARN-level alerts only (suppressed by -I; build GREEN)'
                    echo '  2 → FAIL-level alerts found (build marked UNSTABLE)'
                    echo '============================================================'

                    // Exit code 2 = at least one FAIL-level alert was found.
                    // Mark UNSTABLE rather than FAILED so the team can still
                    // download and review the HTML report before deciding
                    // whether to block the release.
                    if (zapExitCode == 2) {
                        echo ''
                        echo '*** ZAP DAST SCAN — FAIL-level security alerts detected! ***'
                        echo 'Recommended actions:'
                        echo '  1. Click "Build Artifacts" in Jenkins.'
                        echo '  2. Open zap-reports/zap-report.html in your browser.'
                        echo '  3. Review each FAIL-level alert and apply the fix.'
                        echo '  4. Re-run the pipeline to confirm the issue is resolved.'
                        echo '  5. To suppress a false positive, add the alert ID to'
                        echo '     security/zap-rules.tsv with action IGNORE or WARN.'
                        echo ''
                        currentBuild.result = 'UNSTABLE'
                    } else {
                        echo 'ZAP DAST scan passed — no FAIL-level security alerts detected.'
                    }
                }
            }
            post {
                always {
                    // Archive the ZAP HTML report regardless of pass/fail so it
                    // is always accessible from the Jenkins build page under
                    // Build Artifacts → zap-reports/zap-report.html.
                    archiveArtifacts artifacts: 'zap-reports/zap-report.html',
                                     allowEmptyArchive: true,
                                     fingerprint: true
                    echo 'ZAP HTML report archived as build artifact.'
                    echo 'View: Jenkins Build → Build Artifacts → zap-reports/zap-report.html'
                }
            }
        }

    }

    // ── Post Actions ──────────────────────────────────────────
    post {
        success {
            echo "BUILD SUCCESS — ${env.APP_NAME} #${env.BUILD_NUMBER}"
        }
        failure {
            echo "BUILD FAILED — ${env.APP_NAME} #${env.BUILD_NUMBER}. Check the logs above."
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
